#!/usr/bin/python3
"""Privileged entry point used by the PdaNet desktop app through pkexec.

Only three fixed operations are accepted:

    pdanet-gui-helper connect SERIAL
    pdanet-gui-helper disconnect
    pdanet-gui-helper restore

SERIAL must match a strict pattern. No other argument is ever interpreted, no
environment from the caller is trusted (pkexec clears it), and the pdanet CLI is
executed by absolute path with a minimal, fixed environment.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

PDANET_CLI = "/usr/lib/pdanet-linux/bin/pdanet"
RUN_DIR = "/run/pdanet-usb"
PROC_DIR = "/proc"
IP_BIN = "/usr/sbin/ip"
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
SERIAL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:\-]{0,63}$")
USB_IFACE = "pdanet0"
# Exactly the IPv6 blackhole routes `pdanet usb` installs (metric 5, unreachable).
IPV6_BLOCK_ROUTES = ("::/1", "8000::/1")


class UsageError(Exception):
    pass


def running_helper_path(run_dir: str = RUN_DIR, proc_dir: str = PROC_DIR) -> str | None:
    """Path of the USB helper process the CLI previously started, if any.

    The CLI recognises its helper by exact path. A tunnel started by another
    install (e.g. ~/.local) must be addressed with that same path, otherwise the
    packaged CLI would refuse to stop it.
    """
    try:
        with open(os.path.join(run_dir, "helper-pid"), encoding="ascii") as fh:
            pid = fh.readline().strip()
        if not pid.isdigit():
            return None
        with open(os.path.join(proc_dir, pid, "cmdline"), "rb") as fh:
            parts = fh.read().split(b"\0")
    except OSError:
        return None
    for raw in parts:
        arg = raw.decode("utf-8", "replace")
        if arg.startswith("/") and os.path.basename(arg) == "pdanet-usb-helper":
            return arg
    return None


def build_plan(argv: list[str], run_dir: str = RUN_DIR, proc_dir: str = PROC_DIR):
    """Validate *argv* (without program name); return (command, env, post_cleanup)."""
    if not argv:
        raise UsageError("missing command")
    command, rest = argv[0], argv[1:]
    env = {"PATH": SAFE_PATH, "LC_ALL": "C", "HOME": "/root"}
    helper = running_helper_path(run_dir, proc_dir)
    if helper:
        env["PDANET_USB_HELPER"] = helper
    if command == "connect":
        if len(rest) != 1 or not SERIAL_RE.match(rest[0]):
            raise UsageError("connect requires exactly one valid ADB serial")
        env["PDANET_ADB_SERIAL"] = rest[0]
        return [PDANET_CLI, "usb", "on"], env, False
    if command in ("disconnect", "restore"):
        if rest:
            raise UsageError(f"{command} takes no arguments")
        return [PDANET_CLI, "usb", "off"], env, command == "restore"
    raise UsageError(f"unknown command: {command[:32]!r}")


def cleanup_leftovers() -> None:
    """After `usb off`, remove only IPv6 blackhole routes the CLI could have left
    behind (they are not tied to the TUN interface, so a crashed helper leaves them)."""
    for route in IPV6_BLOCK_ROUTES:
        subprocess.run(
            [IP_BIN, "-6", "route", "del", "unreachable", route, "metric", "5"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, check=False, timeout=10,
        )
    subprocess.run(
        ["/usr/bin/resolvectl", "revert", USB_IFACE],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, check=False, timeout=10,
    )


def main(argv: list[str]) -> int:
    try:
        cmd, env, cleanup = build_plan(argv)
    except UsageError as exc:
        print(f"pdanet-gui-helper: {exc}", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("pdanet-gui-helper: must run as root (through pkexec)", file=sys.stderr)
        return 2
    result = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL, check=False)
    if cleanup and not os.path.isfile(os.path.join(RUN_DIR, "helper-pid")):
        cleanup_leftovers()
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
